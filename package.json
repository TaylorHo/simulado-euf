{
	"name": "simulado-euf",
	"version": "1.4.0",
	"type": "module",
	"author": "Taylor Hoffmann <taylor@hoffmann.io>",
	"repository": {
		"type": "git",
		"url": "https://github.com/TaylorHo/simulado-euf"
	},
	"scripts": {
		"dev": "pnpm run dev:web",
		"dev:web": "vite dev",
		"dev:mobile": "TARGET=mobile vite dev",
		"build": "pnpm run build:web",
		"build:web": "vite build",
		"build:mobile": "TARGET=mobile vite build && node scripts/cleanup-mobile-build.js",
		"build:app": "tauri android build --aab && pnpm get-native-libs",
		"get-native-libs": "rm -f merged_native_libs.zip && cd ./src-tauri/gen/android/app/build/intermediates/merged_native_libs/universalRelease/mergeUniversalReleaseNativeLibs/out/lib/ && zip -r ./../../../../../../../../../../../merged_native_libs.zip ./",
		"prepare": "svelte-kit sync || echo '' && git config --local core.hooksPath .hooks/",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write . && eslint --fix --no-warn-ignored .",
		"release:dry-run": "semantic-release --dry-run",
		"release": "semantic-release",
		"tauri": "tauri"
	},
	"lint-staged": {
		"*": [
			"prettier --ignore-unknown --write",
			"eslint --fix --no-warn-ignored"
		]
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.10",
		"@semantic-release/npm": "^13.2.0",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/adapter-vercel": "^7.0.2",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tauri-apps/cli": "^2.12.4",
		"@types/katex": "^0.16.8",
		"@types/node": "^26.6.6",
		"@types/qrcode": "^1.5.6",
		"esbuild": "^0.28.2",
		"eslint": "^10.14.0",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"semantic-release": "^25.0.9",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.7"
	},
	"dependencies": {
		"@lucide/svelte": "^1.70.0",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-http": "^2.8.3",
		"@tauri-apps/plugin-opener": "^2.7.2",
		"jsqr": "^1.4.0",
		"katex": "^0.19.1",
		"posthog-js": "^1.447.5",
		"qrcode": "^1.5.4"
	},
	"license": "AGPL-3.0",
	"engines": {
		"npm": ">=11",
		"pnpm": ">=10",
		"node": ">=20 <26"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
