{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "Simulado EUF",
	"version": "1.3.1",
	"identifier": "io.hoffmann.euf",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "pnpm dev:mobile",
		"beforeBuildCommand": "pnpm build:mobile"
	},
	"app": {
		"windows": [
			{
				"title": "Simulado EUF",
				"width": 800,
				"height": 600,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"android": {
			"debugApplicationIdSuffix": ".debug",
			"versionCode": 6
		}
	}
}
